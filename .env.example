# Environment (development | production | test)
ENVIRONMENT=development
DEBUG=True

# Application URLs
SHORT_DOMAIN=http://localhost:8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database
# Production (PostgreSQL): postgresql+asyncpg://postgres:postgres@localhost:5432/urlforge
# Local Standalone / Testing (SQLite): sqlite+aiosqlite:///./urlforge.db
DATABASE_URL=sqlite+aiosqlite:///./urlforge.db
# Sync database URL for Alembic migrations
SYNC_DATABASE_URL=sqlite:///./urlforge.db

# JWT Security
JWT_SECRET_KEY=urlforge-super-secret-development-key-change-in-production-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (requests per minute)
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3

# Admin Configuration
ADMIN_EMAIL=admin@urlforge.app
ADMIN_PASSWORD=AdminSecurePass123!

# Caching (Optional Redis)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
